# Copy this file to `.env.local` and fill in the real values.
# `.env.local` is gitignored.

# Cloudflare Turnstile site key. Public, OK to embed in the bundle.
# Get it from https://dash.cloudflare.com -> Turnstile -> your widget.
VITE_TURNSTILE_SITE_KEY=

# Public URL of the Cloudflare Worker that proxies Turnstile verification.
# The Apps Scripts we generate for teachers also bake in this URL.
# Default points at production (bare workers.dev URL — no custom-domain
# route needed); override for local Worker testing.
VITE_TURNSTILE_PROXY_URL=https://karaweb-turnstile-proxy.bakerpd.workers.dev

# Set to 'true' for local development so the Turnstile widget is not
# rendered and student submissions go out with an empty token. Pair with
# a no-Turnstile dev Apps Script (generated by the Cloud Save tab's
# "Download dev script" button) for end-to-end local testing.
VITE_SKIP_TURNSTILE=false

# ── Codehooks backend env vars (maintainer only) ─────────────────────
# Production defaults are hardcoded near the top of
# codehooks-backend/index.js (see the "Deployment defaults" block), so
# teachers following the in-app Cloud Save wizard never need to touch
# Codehooks env vars at all.
#
# Listed here as documentation for the rare case where YOU want to
# override on a personal / dev Codehooks instance — e.g. allowing a
# localhost origin during dev, or disabling Turnstile while testing
# without a real token. These values are set in Codehooks Studio →
# Settings → Environment variables (NOT in this .env.local file —
# Codehooks doesn't read it).
#
#   ALLOWED_ORIGINS         comma-separated allowlist of Origin headers.
#                           Default: https://karaweb.classinteractives.co.uk
#                           Example dev override:
#                             http://localhost:5173,https://karaweb.classinteractives.co.uk
#
#   DISABLE_ORIGIN_CHECKS   "true" skips the allowlist entirely.
#                           Default: false (allowlist enforced).
#                           Use only on a throwaway dev project.
#
#   TURNSTILE_REQUIRED      "false" disables bot verification for every
#                           submission. Default: true (recommended for
#                           any live deployment).
#
#   TURNSTILE_VERIFY_URL    Override the shared Worker proxy URL.
#                           Default:
#                             https://karaweb-turnstile-proxy.bakerpd.workers.dev
#                           Use only when running your own Worker.
#
# `TURNSTILE_SECRET_KEY` is NO LONGER read by the Codehooks backend —
# the shared Worker proxy holds the only copy.
